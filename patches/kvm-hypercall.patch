 EXPORT_SYMBOL_FOR_KVM_INTERNAL(____kvm_emulate_hypercall);
 
+static bool kvm_hidden_guest_ud(struct kvm_vcpu *vcpu)
+{
+	struct kvm_cpuid_entry2 *leaf1;
+
+	if (!hidden_guest_ud)
+		return false;
+	leaf1 = kvm_find_cpuid_entry(vcpu, 1);
+	return !leaf1 || !(leaf1->ecx & BIT(31));
+}
+
 int kvm_emulate_hypercall(struct kvm_vcpu *vcpu)
 {
+	if (kvm_hidden_guest_ud(vcpu)) {
+		kvm_queue_exception(vcpu, UD_VECTOR);
+		return 1;
+	}
+
 	if (kvm_xen_hypercall_enabled(vcpu->kvm))
 		return kvm_xen_hypercall(vcpu);
 
