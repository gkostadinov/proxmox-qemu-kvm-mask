+/* Opt-in: match bare CPU hypercall behavior for unadvertised guests. */
+static bool __read_mostly hidden_guest_ud;
+module_param(hidden_guest_ud, bool, 0644);
+MODULE_PARM_DESC(hidden_guest_ud,
+                "Inject #UD for hypercalls when guest CPUID hides the hypervisor");
 
 static bool __read_mostly ignore_msrs = 0;
 module_param(ignore_msrs, bool, 0644);
@@ -10528,8 +10534,23 @@
